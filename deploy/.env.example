# Copy to deploy/.env on the droplet. Never commit the real file.

# --- Database (DreamHost MySQL) ---
# mysql://USER:PASSWORD@HOST:3306/DATABASE (URL-encode special characters in the password)
MYSQL_URL=
# true if your MySQL host supports TLS (use it whenever it does)
MYSQL_SSL=false

# --- Model providers ---
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# --- Site and login ---
# Your domain, e.g. quiz.example.com (DNS A record pointing at the droplet)
SITE_ADDRESS=
BASIC_AUTH_USER=josh
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your password'
# Keep the single quotes so the $ characters are not expanded.
BASIC_AUTH_HASH='$2a$14$replace-me'

# Optional: pin a specific image (a commit sha tag) instead of "latest"
# SPROUT_TAG=latest
